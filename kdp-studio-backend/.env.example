# KDP Studio AI Backend Environment Variables
APP_NAME="KDP Studio AI Backend"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database
DATABASE_URL="postgresql+asyncpg://kdp_user:kdp_password@localhost:5432/kdp_studio"
SYNC_DATABASE_URL="postgresql+psycopg2://kdp_user:kdp_password@localhost:5432/kdp_studio"

# Redis & Celery Task Queue
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# AI & Research Integrations
GEMINI_API_KEY="MY_GEMINI_API_KEY"
LLM_DEFAULT_MODEL="gemini-2.5-flash"
AMAZON_PAAPI_ACCESS_KEY=""
AMAZON_PAAPI_SECRET_KEY=""
AMAZON_PARTNER_TAG=""
IMAGE_GEN_PROVIDER="gemini"

# Storage (local | s3)
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./storage"
S3_BUCKET_NAME=""
S3_REGION="us-east-1"

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
